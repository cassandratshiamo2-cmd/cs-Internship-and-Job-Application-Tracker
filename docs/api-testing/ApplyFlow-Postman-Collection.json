            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gmail/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gmail", "sync"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sync returns a documented outcome', function () {",
                  "  pm.expect([200, 429, 502]).to.include(pm.response.code);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message).to.be.a('string');",
                  "  if (pm.response.code === 429) pm.expect(pm.response.headers.get('Retry-After')).to.exist;",
                  "});"
                ]
              }
            }
          ]
