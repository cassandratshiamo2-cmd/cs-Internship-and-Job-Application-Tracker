          "name": "GET Gmail processing history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gmail/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gmail", "history"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('History returns completed review outcomes', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const messages = pm.response.json().messages;",
                  "  pm.expect(messages).to.be.an('array');",
