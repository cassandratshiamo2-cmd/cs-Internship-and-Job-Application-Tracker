        {
          "name": "GET API health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Health reports its database state', function () {",
                  "  pm.expect([200, 503]).to.include(pm.response.code);",
                  "  const body = pm.response.json();",
                  "  pm.expect(['UP', 'DOWN']).to.include(body.status);",
                  "  pm.expect(body).to.have.property('timestamp');",
