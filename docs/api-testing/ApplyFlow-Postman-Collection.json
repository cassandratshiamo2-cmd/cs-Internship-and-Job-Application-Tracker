          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Review queue returns review messages', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const messages = pm.response.json().messages;",
                  "  pm.expect(messages).to.be.an('array');",
                  "  messages.forEach(function (message) { pm.expect(message.retryable).to.be.a('boolean'); });",
                  "});",
                  "const messages = pm.response.json().messages;",
                  "if (messages.length) pm.collectionVariables.set('gmailReviewMessageId', messages[0].id);"
                ]
              }
            }
