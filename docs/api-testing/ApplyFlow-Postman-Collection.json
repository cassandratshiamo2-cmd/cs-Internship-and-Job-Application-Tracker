            "url": {
              "raw": "{{baseUrl}}/api/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration creates a user', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user).to.have.property('id');",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('testEmail').trim().toLowerCase());",
                  "  pm.expect(body.user).not.to.have.property('password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
