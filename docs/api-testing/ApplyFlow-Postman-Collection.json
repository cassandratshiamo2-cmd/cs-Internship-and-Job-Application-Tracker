          "name": "POST Start Gmail OAuth",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gmail/connect",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gmail", "connect"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OAuth start returns a URL or an explicit configuration error', function () {",
                  "  pm.expect([200, 503]).to.include(pm.response.code);",
                  "  const body = pm.response.json();",
                  "  if (pm.response.code === 200) pm.expect(body.authorizationUrl).to.match(/^https:\\/\\//);",
                  "  else pm.expect(body.message).to.include('not configured');",
                  "});"
